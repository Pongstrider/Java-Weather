<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/linearLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">


    <ImageView
        android:id="@+id/cloIcon"
        android:layout_width="116dp"
        android:layout_height="80dp"
        android:contentDescription="Grattis-ikon"
        android:src="@mipmap/clo"
        tools:layout_editor_absoluteX="36dp"
        tools:layout_editor_absoluteY="338dp" />

    <Button
        android:id="@+id/GPS"
        style="@android:style/Widget.DeviceDefault.Button.Borderless"
        android:layout_width="22dp"
        android:layout_height="35dp"
        android:background="@android:color/transparent"
        android:drawableStart="@drawable/baseline_navigation_24"
        android:drawablePadding="8dp"
        android:rotation="21"
        android:text=""
        tools:layout_editor_absoluteX="346dp"
        tools:layout_editor_absoluteY="30dp" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieBackground"
        android:layout_width="193dp"
        android:layout_height="193dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.5"
        app:layout_constraintHorizontal_bias="0.206"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.219"
        app:layout_constraintWidth_percent="0.5"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/little_sun" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="48dp"
        android:layout_height="37dp"
        android:text="28°"
        android:textSize="28sp"
        tools:layout_editor_absoluteX="258dp"
        tools:layout_editor_absoluteY="146dp" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="178dp"
        android:layout_height="47dp"
        android:text="Stad Namn!"
        android:textSize="30sp"
        tools:layout_editor_absoluteX="55dp"
        tools:layout_editor_absoluteY="41dp" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="397dp"
        android:layout_height="110dp"
        tools:layout_editor_absoluteX="10dp"
        tools:layout_editor_absoluteY="616dp"
        tools:srcCompat="@drawable/image" />

</androidx.constraintlayout.widget.ConstraintLayout>

